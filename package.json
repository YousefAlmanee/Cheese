{
  "name": "cheese",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:local": "bash scripts/local-db.sh",
    "dev:mock": "cross-env TMDB_API_KEY=mock TWITCH_CLIENT_ID=mock TWITCH_CLIENT_SECRET=mock NODE_OPTIONS=\"--import ./scripts/mock-apis.mjs\" next dev",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@netlify/functions": "^6.0.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

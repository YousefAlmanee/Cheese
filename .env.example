# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# Postgres connection string (Neon, Supabase, or any Postgres 14+)
DATABASE_URL=postgres://postgres@127.0.0.1:54329/cheese
# Optional. Connections per server instance (default 5). Keep it low on serverless, and use your host's pooled connection string.
# DATABASE_POOL_MAX=5
# Tests only: the database `npm test` and `npm run test:e2e` wipe and reuse. Never point it at real data.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/cheese_test

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: lets you sign in with email and password. Ignored in production builds.
ENABLE_DEV_LOGIN=1

# Search providers
TMDB_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# Reminders (web push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret that the scheduled reminder job sends in the Authorization header
CRON_SECRET=
